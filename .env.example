# Configura��o da API OpenAI (n�o versione a chave real)
APP_ENV=development
ENABLE_TIME_CARD=true
OPENAI_API_KEY=sua_chave_openai_aqui

# Produção: Worker Cloudflare que persiste jobs e PDFs no D1/R2.
STATE_API_URL=https://seu-worker.workers.dev
STATE_API_TOKEN=defina_um_token_longo
SAVED_EXTRACTION_RETENTION_DAYS=90

# Diret�rio base dos documentos de entrada
DATA_INPUT_DIR=../data_input

# A interface local n�o exige senha. Defina como true somente no build de produ��o.
VITE_REQUIRE_LOGIN=false
